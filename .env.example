# Houni n7addou el mode mta3 el application.
# Fel developpement nesta3mlou development.
NODE_ENV=development

# El serveur bech yasma3 lel requetes 3al port hedha
PORT=3000

# Hedha el lien lel MongoDB local
# ds_backend houwa esm el base de donnees mta3 el projet.
MONGODB_URI=mongodb://127.0.0.1:27017/ds_backend

# Houni nkhalliw el valeur fergha khater hedha fichier exemple.
# Mba3d n7ottou secret 9wi ken fel fichier .env.
JWT_SECRET=

# El token yab9a s7i7 1heure, mba3d el user ya3mel login men jdid.
JWT_EXPIRES_IN=1h
